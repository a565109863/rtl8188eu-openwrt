From: OpenWrt rtl8188eu package
Subject: cfg80211: match 6.12+ wiphy callback signatures

cfg80211_ops uses radio_idx / link_id (e.g. multi-radio / MLO) on 6.12+ in
OpenWrt and upstream-aligned trees. Gate the extra parameters on
KERNEL_VERSION(6, 12, 0) and ignore them for this single-radio driver; fixes
-Wincompatible-pointer-types for set_wiphy_params, set_tx_power, and
get_tx_power.

---
 os_dep/linux/ioctl_cfg80211.c | 31 +++++++++++++++++++++++++++++--
 1 file changed, 29 insertions(+), 2 deletions(-)

diff --git a/os_dep/linux/ioctl_cfg80211.c b/os_dep/linux/ioctl_cfg80211.c
--- a/os_dep/linux/ioctl_cfg80211.c
+++ b/os_dep/linux/ioctl_cfg80211.c
@@ -3589,8 +3589,15 @@
 }
 #endif
 
-static int cfg80211_rtw_set_wiphy_params(struct wiphy *wiphy, u32 changed)
+static int cfg80211_rtw_set_wiphy_params(struct wiphy *wiphy,
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0))
+	int radio_idx,
+#endif
+	u32 changed)
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0))
+	(void)radio_idx;
+#endif
 #if 0
 	struct iwm_priv *iwm = wiphy_to_iwm(wiphy);
 
@@ -4574,12 +4581,18 @@
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(3, 8, 0))
 	struct wireless_dev *wdev,
 #endif
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0))
+	int radio_idx,
+#endif
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(2, 6, 36)) || defined(COMPAT_KERNEL_RELEASE)
 	enum nl80211_tx_power_setting type, int mbm)
 #else
 	enum tx_power_setting type, int dbm)
 #endif
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0))
+	(void)radio_idx;
+#endif
 #if !((LINUX_VERSION_CODE >= KERNEL_VERSION(2, 6, 36)) || defined(COMPAT_KERNEL_RELEASE))
 	int mbm = dbm * 100;
 #endif
@@ -4636,8 +4649,16 @@
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(3, 8, 0))
 	struct wireless_dev *wdev,
 #endif
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0))
+	int radio_idx,
+	unsigned int link_id,
+#endif
 	int *dbm)
 {
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0))
+	(void)radio_idx;
+	(void)link_id;
+#endif
 	struct dvobj_priv *dvobj = wiphy_to_dvobj(wiphy);
 	s16 mbm;
 
